{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "final_space": true,
  "console_title_template": "{{ .Folder }}{{ if .Root }} (admin){{ end }}",
  "palette": {
    "bg": "#1a1b26",
    "fg": "#c0caf5",
    "blue": "#7aa2f7",
    "cyan": "#7dcfff",
    "green": "#9ece6a",
    "purple": "#bb9af7",
    "red": "#f7768e",
    "orange": "#ff9e64",
    "yellow": "#e0af68",
    "dim": "#565f89"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:dim",
          "template": "╭─"
        },
        {
          "type": "session",
          "style": "plain",
          "foreground": "p:red",
          "template": " {{ if .Root }} root {{ end }}"
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "p:blue",
          "template": " {{ .Path }}",
          "properties": {
            "style": "agnoster_short",
            "max_depth": 3,
            "home_icon": "~",
            "folder_separator_icon": "  "
          }
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "p:green",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:yellow{{ end }}",
            "{{ if gt .Ahead 0 }}p:cyan{{ end }}",
            "{{ if gt .Behind 0 }}p:orange{{ end }}"
          ],
          "template": "  {{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }}  {{ .StashCount }}{{ end }}",
          "properties": {
            "fetch_status": true,
            "fetch_upstream_icon": true,
            "fetch_stash_count": true,
            "branch_icon": " "
          }
        },
        {
          "type": "node",
          "style": "plain",
          "foreground": "p:green",
          "template": "   {{ .Full }}",
          "properties": { "display_mode": "files", "fetch_package_manager": false }
        },
        {
          "type": "python",
          "style": "plain",
          "foreground": "p:yellow",
          "template": "   {{ .Full }}{{ if .Venv }} ({{ .Venv }}){{ end }}",
          "properties": { "display_mode": "files", "fetch_virtual_env": true }
        },
        {
          "type": "go",
          "style": "plain",
          "foreground": "p:cyan",
          "template": "   {{ .Full }}",
          "properties": { "display_mode": "files" }
        },
        {
          "type": "rust",
          "style": "plain",
          "foreground": "p:orange",
          "template": "   {{ .Full }}",
          "properties": { "display_mode": "files" }
        },
        {
          "type": "dotnet",
          "style": "plain",
          "foreground": "p:purple",
          "template": "   {{ .Full }}",
          "properties": { "display_mode": "files" }
        },
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "p:dim",
          "template": "   {{ .FormattedMs }}",
          "properties": { "threshold": 2000, "style": "austin" }
        }
      ]
    },
    {
      "type": "rprompt",
      "overflow": "hidden",
      "segments": [
        {
          "type": "time",
          "style": "plain",
          "foreground": "p:dim",
          "template": "{{ .CurrentDate | date \"15:04\" }}",
          "properties": { "time_format": "15:04" }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:dim",
          "template": "╰─"
        },
        {
          "type": "status",
          "style": "plain",
          "foreground": "p:purple",
          "foreground_templates": [
            "{{ if gt .Code 0 }}p:red{{ end }}"
          ],
          "template": "❯ ",
          "properties": { "always_enabled": true }
        }
      ]
    }
  ],
  "transient_prompt": {
    "background": "transparent",
    "foreground": "p:dim",
    "template": "❯ "
  },
  "secondary_prompt": {
    "background": "transparent",
    "foreground": "p:dim",
    "template": "╰─❯ "
  }
}
